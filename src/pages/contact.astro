---
import Base from '../layouts/Base.astro';
import { profile, SHOW_PLACEHOLDERS } from '../data/site';
import { url } from '../lib/url';
const hasForm = profile.web3formsKey.trim().length > 0;
---
<Base title="Contact" description="Contact Aaron Scott about operations roles, Backhouse Group consulting, or his projects.">
  <div class="contact">
    <span class="kicker">Contact</span>
    <h1>Get in touch</h1>
    <p class="tagline">For operations roles, consulting engagements with Backhouse Group, or questions about my projects, please send a message. It will come directly to my inbox.</p>

    {hasForm ? (
      <form class="form" action="https://api.web3forms.com/submit" method="POST" id="contact-form">
        <input type="hidden" name="access_key" value={profile.web3formsKey} />
        <input type="hidden" name="subject" value="New message from your website" />
        <input type="hidden" name="from_name" value="Personal website" />
        <input type="hidden" name="redirect" value={new URL(url('contact/thanks/'), Astro.site).href} />
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
        <label>Your email<input type="email" name="email" required autocomplete="email" /></label>
        <label>Topic
          <select name="topic">
            <option>Hiring</option>
            <option>Consulting (Backhouse Group)</option>
            <option>A project</option>
            <option>Something else</option>
          </select>
        </label>
        <label>Message<textarea name="message" rows="6" required></textarea></label>
        <button class="button" type="submit">Send message</button>
      </form>
    ) : (
      <>
        <p><a class="button" href={`mailto:${profile.email}`}>Email me</a></p>
        {SHOW_PLACEHOLDERS && (
          <div class="placeholder">
            <p style="margin-top:0">Placeholder: preview of the contact form. It isn’t switched on yet, so please use the email button above.</p>
            <form class="form" aria-label="Contact form preview (not active)" onsubmit="return false">
              <fieldset disabled style="border:0;padding:0;margin:0;display:grid;gap:1rem">
                <label>Your name<input type="text" /></label>
                <label>Your email<input type="email" /></label>
                <label>Topic<select><option>Hiring</option><option>Consulting (Backhouse Group)</option><option>A project</option><option>Something else</option></select></label>
                <label>Message<textarea rows="4"></textarea></label>
                <button class="button" type="button">Send message</button>
              </fieldset>
            </form>
          </div>
        )}
      </>
    )}
    <p class="muted">You can also find me on <a href={profile.linkedin}>LinkedIn</a>.</p>
    {profile.resume
      ? <p><a href={url(profile.resume)}>Download my résumé (PDF)</a></p>
      : SHOW_PLACEHOLDERS && <p class="placeholder">Placeholder: a résumé download link goes here.</p>}
  </div>
</Base>
