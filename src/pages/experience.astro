---
import Base from '../layouts/Base.astro';
import { tracks, earlier, education, skills, profile, SHOW_PLACEHOLDERS } from '../data/site';
import { url } from '../lib/url';
---
<Base title="Experience" description="Aaron Scott's experience in restaurant operations, business development, and civic and policy work.">
  <header class="page-head wide">
    <span class="kicker">Experience</span>
    <h1>Professional experience</h1>
    <nav class="track-nav" aria-label="Jump to a track">
      {tracks.map((t, i) => <a href={`#${t.id}`}><span class="nav-num" aria-hidden="true">0{i + 1}</span>{t.name}</a>)}
      <a href="#education"><span class="nav-num" aria-hidden="true">0{tracks.length + 1}</span>Education</a>
    </nav>
    {profile.resume
      ? <p><a class="button" href={url(profile.resume)}>Download résumé (PDF)</a></p>
      : SHOW_PLACEHOLDERS && <p><span class="button placeholder-btn" aria-disabled="true">Download résumé (PDF, coming soon)</span></p>}
  </header>

  {tracks.map((t, i) => (
    <section class="track wide" id={t.id}>
      <div class="track-head">
        <span class="track-num" aria-hidden="true">0{i + 1}</span>
        <div>
          <h2>{t.name}</h2>
          <p class="muted">{t.intro}</p>
        </div>
      </div>
      {t.jobs.map((j) => (
        <article class="job">
          <div class="job-meta">
            <span class="meta">{j.period}</span>
            {j.note && <span class="meta muted">{j.note}</span>}
          </div>
          <div class="job-body">
            <h3>{j.org}</h3>
            <p class="job-title">{j.title}</p>
            {j.ladder && (
              <ol class="ladder-steps" aria-label="Career ladder">
                {j.ladder.map((step, k) => <li style={`--i:${k}`}><span>{step}</span></li>)}
              </ol>
            )}
            {j.highlights && <ul class="chips">{j.highlights.map((h) => <li>{h}</li>)}</ul>}
            {j.story.map((p) => <p>{p}</p>)}
          </div>
        </article>
      ))}
    </section>
  ))}

  <section class="section wide">
    <p class="muted"><strong>Earlier:</strong> {earlier}</p>
  </section>

  <section class="track wide" id="education">
    <div class="track-head">
      <span class="track-num" aria-hidden="true">0{tracks.length + 1}</span>
      <div><h2>Education</h2></div>
    </div>
    <article class="job">
      <div class="job-meta"><span class="meta">{education.year}</span></div>
      <div class="job-body">
        <h3>{education.school}</h3>
        <p class="job-title">{education.degree}. {education.minors}.</p>
        <ul class="chips">{education.honors.map((h) => <li>{h}</li>)}</ul>
        <p class="muted">Certifications: {education.certs.join(' · ')}</p>
      </div>
    </article>
  </section>

  <section class="section wide">
    <h2>Skills</h2>
    <div class="skills">
      {skills.map((s) => (
        <div>
          <h3>{s.group}</h3>
          <ul>{s.items.map((i) => <li class="tag">{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>
