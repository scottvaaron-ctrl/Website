---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';
import { SHOW_PLACEHOLDERS } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.hidden && (SHOW_PLACEHOLDERS || !data.placeholder));
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---
<Base title={d.title} description={d.summary}>
  <article class="project">
    <a class="back" href={url('projects/')}>← All projects</a>
    <header class="project-head">
      <p class="kicker" style="margin-top:2rem">{[d.category, ...d.tags.filter((t) => t !== d.category)].join(' · ')}</p>
      <h1>{d.title}</h1>
      <p class="tagline">{d.summary}</p>
    </header>

    <dl class="facts">
      <div><dt>Status</dt><dd><span class="status" data-s={d.status}>{d.status}</span>{d.statusNote && <span class="muted"> · {d.statusNote}</span>}</dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>When</dt><dd>{d.period}</dd></div>
      {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
    </dl>

    {d.image && (
      <figure class="hero-img">
        <img src={url(d.image)} alt={d.imageAlt ?? ''} />
      </figure>
    )}

    {d.flow.length > 0 && (
      <section class="flow-wrap" aria-label="How it works">
        <p class="kicker">How it works</p>
        <ol class="flow">{d.flow.map((f, i) => <li><span class="flow-n">{i + 1}</span>{f}</li>)}</ol>
      </section>
    )}

    {d.quote && (
      <blockquote class="pull"><p>“{d.quote}”</p><cite>Aaron Scott</cite></blockquote>
    )}

    <div class="prose"><Content /></div>

    {d.links.length > 0 && (
      <p style="margin-top:2rem;display:flex;gap:0.75rem;flex-wrap:wrap">
        {d.links.map((l) => <a class="button" href={l.url}>{l.label}</a>)}
      </p>
    )}
    {d.links.length === 0 && d.placeholderLink && SHOW_PLACEHOLDERS && (
      <p style="margin-top:2rem"><span class="button placeholder-btn" aria-disabled="true">{d.placeholderLink} (link coming soon)</span></p>
    )}
  </article>
</Base>
