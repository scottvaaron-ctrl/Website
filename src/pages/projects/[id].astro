---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.hidden);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
---
<Base title={d.title} description={d.summary}>
  <article>
    <a class="back" href={url('projects/')}>← All projects</a>
    <p class="kicker" style="margin-top:2rem">{d.category}</p>
    <h1>{d.title}</h1>
    <p class="tagline">{d.summary}</p>

    <dl class="facts">
      <div><dt>Status</dt><dd><span class="status" data-s={d.status}>{d.status}</span></dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>When</dt><dd>{d.period}</dd></div>
      {d.tools.length > 0 && <div><dt>Tools</dt><dd>{d.tools.join(', ')}</dd></div>}
    </dl>

    <div class="prose"><Content /></div>

    {d.links.length > 0 && (
      <p style="margin-top:2rem;display:flex;gap:0.75rem;flex-wrap:wrap">
        {d.links.map((l) => <a class="button" href={l.url}>{l.label}</a>)}
      </p>
    )}
  </article>
</Base>
