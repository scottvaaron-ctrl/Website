---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, proof, paths, tracks, now, SHOW_PLACEHOLDERS } from '../data/site';
import { url } from '../lib/url';

const featured = (await getCollection('projects', ({ data }) => data.featured && !data.hidden && (SHOW_PLACEHOLDERS || !data.placeholder)))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const initials = profile.name.split(' ').map((p) => p[0]).join('');
const ops = tracks.find((t) => t.id === 'operations')!.jobs;
const biz = tracks.find((t) => t.id === 'business')!.jobs;
const timeline = [ops[0], biz[0], ops[1], ops[2]];
---
<Base>
  <section class="hero wide">
    <div>
      <span class="kicker">Operations · Consulting · Policy · Technology</span>
      <h1 class="display">{profile.name}</h1>
      <p class="tagline">{profile.tagline}</p>
      <ul class="roles">{profile.roles.map((r) => <li class="tag">{r}</li>)}</ul>
    </div>
    {profile.headshot
      ? <img class="headshot" src={url(profile.headshot)} alt={`Photo of ${profile.name}`} width="208" height="208" />
      : SHOW_PLACEHOLDERS
        ? <div class="headshot placeholder-photo" role="img" aria-label="Photo placeholder">Photo<br />coming soon</div>
        : <div class="headshot" aria-hidden="true">{initials}</div>}
  </section>

  <section class="band wide" aria-labelledby="proof">
    <h2 id="proof" class="kicker">By the numbers</h2>
    <div class="proof">
      {proof.map((n) => (
        <div>
          <strong><b class="sr-only">{n.value}</b><b aria-hidden="true" data-count>{n.value}</b></strong>
          <span>{n.label}</span>
        </div>
      ))}
    </div>
    <script>
      // Numbers count up once when they scroll into view. Skipped for visitors
      // who ask their device for reduced motion; the final number is always in the page.
      const els = [...document.querySelectorAll<HTMLElement>('[data-count]')];
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!still && 'IntersectionObserver' in window) {
        const run = (el: HTMLElement) => {
          const m = el.textContent!.match(/^(\D*)([\d,]+)(\D*)$/);
          if (!m) return;
          const [, pre, num, post] = m;
          const end = Number(num.replace(/,/g, ''));
          const start = performance.now();
          const step = (t: number) => {
            const p = Math.min(Math.max((t - start) / 1200, 0), 1);
            const v = Math.round(end * (1 - Math.pow(1 - p, 3)));
            el.textContent = pre + v.toLocaleString('en-US') + post;
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { io.unobserve(e.target); run(e.target as HTMLElement); }
        }, { threshold: 0.5 });
        els.forEach((el) => io.observe(el));
      }
    </script>
  </section>

  <section class="section wide" aria-labelledby="start">
    <h2 id="start" class="kicker">Start here</h2>
    <div class="paths">
      {paths.map((p, i) => (
        <a class="path" href={url(p.href)}>
          <span class="path-n" aria-hidden="true">0{i + 1}</span>
          <span class="kicker">{p.kicker}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
          <span class="cta">{p.cta} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wide" aria-labelledby="work">
    <div class="section-head">
      <h2 id="work">Featured work</h2>
      <a class="mono" href={url('projects/')}>All projects →</a>
    </div>
    <div class="cards cards-feature">{featured.map((p) => <ProjectCard project={p} large />)}</div>
  </section>

  <blockquote class="pull wide">
    <p>“The tedious work is done by agents, which allows the humans to ideate and improve.”</p>
    <cite>Aaron Scott</cite>
  </blockquote>

  <section class="section wide" aria-labelledby="exp">
    <div class="section-head">
      <h2 id="exp">Experience</h2>
      <a class="mono" href={url('experience/')}>Full experience →</a>
    </div>
    <ul class="timeline">
      {timeline.map((e) => (
        <li>
          <span class="meta">{e.period}</span>
          <div>
            <h3>{e.org}</h3>
            <p class="job-title" style="margin-bottom:0.4rem">{e.title}</p>
            <p class="muted" style="margin:0">{e.summary ?? e.story[0]}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="section split wide" aria-labelledby="now">
    <div>
      <span class="kicker">Now · {now.updated}</span>
      <h2 id="now">Current focus</h2>
      <ul class="now-mini">{now.items.slice(0, 3).map((i) => <li>{i}</li>)}</ul>
      <a class="mono" href={url('now/')}>View all current work →</a>
    </div>
    <div class="cta-box">
      <h2>Get in touch</h2>
      <p class="muted">For hiring, consulting and collaboration inquiries.</p>
      <a class="button" href={url('contact/')}>Contact me</a>
    </div>
  </section>
</Base>
